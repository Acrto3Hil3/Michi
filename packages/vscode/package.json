{
  "name": "michi",
  "displayName": "MICHI",
  "description": "MICHI \u2014 turn an idea into requirements, decisions, architecture and a precise brief for your AI coding agent. Local-first, no API key, works with Claude Code, Cursor, Copilot, Codex, Zed and more.",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "publisher": "dev-subhash",
  "author": {
    "name": "Subhash Yadav",
    "url": "https://github.com/Acrto3Hil3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acrto3Hil3/Michi.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/Acrto3Hil3/Michi/issues"
  },
  "homepage": "https://github.com/Acrto3Hil3/Michi#readme",
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "michi",
    "ai",
    "ai-agent",
    "coding-agent",
    "requirements",
    "architecture",
    "agents-md",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "type": "commonjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "michi.setup",
        "title": "MICHI: Set up in this project"
      },
      {
        "command": "michi.status",
        "title": "MICHI: What needs me?"
      },
      {
        "command": "michi.connectAgent",
        "title": "MICHI: Connect a coding agent"
      },
      {
        "command": "michi.explain",
        "title": "MICHI: Explain this decision or requirement"
      }
    ],
    "configuration": {
      "title": "MICHI",
      "properties": {
        "michi.path": {
          "type": "string",
          "default": "michi",
          "description": "Path to the michi executable. Leave as 'michi' if it is on your PATH."
        },
        "michi.offerSetup": {
          "type": "boolean",
          "default": true,
          "description": "Offer to set MICHI up when opening a project that does not have it yet. MICHI never writes anything without asking."
        }
      }
    }
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "ovsx": "^0.10.1"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0B0B",
    "theme": "dark"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "pnpm build && vsce package --no-dependencies --out michi.vsix",
    "publish:vscode": "vsce publish --no-dependencies",
    "publish:openvsx": "ovsx publish michi.vsix"
  }
}
